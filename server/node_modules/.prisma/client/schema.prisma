generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER") // USER, ADMIN
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Car {
  id           Int          @id @default(autoincrement())
  name         String
  slug         String       @unique
  base_price   Float
  description  String
  range        Int // in miles
  top_speed    Int // in mph
  category     String       @default("Sedan") // Sedan, SUV, Truck, Sports
  drive_train  String       @default("AWD") // RWD, AWD, Dual Motor
  acceleration Float        @default(3.1) // 0-60 mph
  variants     CarVariant[]
  colors       CarColor[]
  orders       Order[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model CarVariant {
  id    Int    @id @default(autoincrement())
  name  String
  price Float
  car   Car    @relation(fields: [carId], references: [id])
  carId Int
}

model CarColor {
  id       Int    @id @default(autoincrement())
  name     String
  price    Float
  imageUrl String
  car      Car    @relation(fields: [carId], references: [id])
  carId    Int
}

model Order {
  id                Int      @id @default(autoincrement())
  user              User     @relation(fields: [userId], references: [id])
  userId            Int
  car               Car      @relation(fields: [carId], references: [id])
  carId             Int
  status            String   @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED
  configurationJson Json
  totalPrice        Float
  createdAt         DateTime @default(now())
}
